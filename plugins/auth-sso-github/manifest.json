{
  "apiVersion": "plugin/v3",
  "id": "auth-sso-github",
  "version": "1.0.0",
  "name": "Sign in with GitHub",
  "publisher": "iam-platform",
  "kinds": [
    "auth-method"
  ],
  "provides": [
    "auth.sso-github"
  ],
  "extends": "auth-sso-github-base",
  "hooks": [
    {
      "name": "auth.prepare",
      "mode": "blocking"
    },
    {
      "name": "auth.verification",
      "mode": "blocking"
    },
    {
      "name": "auth.external.start",
      "mode": "blocking"
    },
    {
      "name": "auth.external.verify",
      "mode": "blocking"
    }
  ],
  "settings": [
    {
      "key": "clientId",
      "type": "string",
      "label": "Client ID",
      "help": "Of a GitHub OAuth app. Empty = SIMULATED demonstration mode.",
      "default": "",
      "group": "GitHub"
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "label": "Client secret",
      "group": "GitHub"
    }
  ],
  "authMethod": {
    "name": "GitHub",
    "description": "Federated sign-in with a GitHub account (OAuth2 with PKCE + state; GitHub has no OIDC id_token). The account must be explicitly linked to a local account.",
    "factor": "other",
    "amr": "fed",
    "maturity": "implemented",
    "suggestedLevel": 6,
    "provisioning": "admin-demo"
  },
  "entrypoints": {
    "handlers": "handlers.mjs"
  },
  "security": {
    "signed": true
  }
}
