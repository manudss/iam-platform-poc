{
  "apiVersion": "plugin/v3",
  "id": "auth-password",
  "version": "1.0.0",
  "name": "Password sign-in (base)",
  "publisher": "iam-platform",
  "kinds": [
    "auth-method"
  ],
  "base": true,
  "provides": [
    "auth.password"
  ],
  "hooks": [
    {
      "name": "auth.authenticate",
      "mode": "blocking"
    },
    {
      "name": "auth.prepare",
      "mode": "blocking"
    },
    {
      "name": "auth.verify",
      "mode": "blocking"
    },
    {
      "name": "auth.verification",
      "mode": "blocking"
    }
  ],
  "settings": [
    {
      "key": "minLength",
      "type": "number",
      "label": "Minimum password length",
      "default": 12,
      "min": 8,
      "max": 128,
      "group": "Policy"
    },
    {
      "key": "allowedDomains",
      "type": "list",
      "label": "Allowed e-mail domains (empty = all)",
      "default": [],
      "group": "Policy"
    }
  ],
  "entrypoints": {
    "handlers": "handlers.mjs"
  },
  "security": {
    "signed": true
  },
  "authMethod": {
    "name": "Password",
    "description": "Checks the directory password through the platform password slot (a lockout replacement plugin still applies).",
    "factor": "knowledge",
    "amr": "pwd",
    "maturity": "implemented",
    "suggestedLevel": 3,
    "provisioning": "directory",
    "inlineWithUsername": true,
    "instances": "single"
  },
  "profileComponents": [
    {
      "id": "password",
      "title": "Password",
      "component": "screens/profile.mjs",
      "surfaces": {
        "self": "manage",
        "admin": "hidden"
      },
      "order": 10
    }
  ]
}
