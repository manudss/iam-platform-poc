{
  "apiVersion": "plugin/v3",
  "id": "auth-sso-facebook",
  "version": "1.0.0",
  "name": "Sign in with Facebook",
  "publisher": "iam-platform",
  "kinds": [
    "auth-method"
  ],
  "provides": [
    "auth.sso-facebook"
  ],
  "extends": "auth-sso-facebook-base",
  "hooks": [
    {
      "name": "auth.prepare",
      "mode": "blocking"
    },
    {
      "name": "auth.verification",
      "mode": "blocking"
    },
    {
      "name": "auth.external.start",
      "mode": "blocking"
    },
    {
      "name": "auth.external.verify",
      "mode": "blocking"
    }
  ],
  "settings": [
    {
      "key": "clientId",
      "type": "string",
      "label": "App ID",
      "help": "Of a Meta app with Facebook Login. Empty = SIMULATED demonstration mode.",
      "default": "",
      "group": "Facebook"
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "label": "App secret",
      "group": "Facebook"
    },
    {
      "key": "apiVersion",
      "type": "string",
      "label": "Graph API version",
      "default": "v19.0",
      "pattern": "^v[0-9]+\\.[0-9]+$",
      "group": "Facebook"
    }
  ],
  "authMethod": {
    "name": "Facebook",
    "description": "Federated sign-in with a Facebook account (OAuth2 manual flow: state, token exchange and a debug_token check that the token belongs to this app - Facebook Login is not OIDC). The account must be explicitly linked to a local account.",
    "factor": "other",
    "amr": "fed",
    "maturity": "implemented",
    "suggestedLevel": 6,
    "provisioning": "admin-demo"
  },
  "entrypoints": {
    "handlers": "handlers.mjs"
  },
  "security": {
    "signed": true
  }
}
