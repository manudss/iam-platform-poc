{
  "apiVersion": "plugin/v3",
  "id": "auth-totp-base",
  "version": "1.0.0",
  "name": "TOTP slot (refusing base)",
  "publisher": "iam-platform",
  "kinds": [
    "auth-method"
  ],
  "base": true,
  "provides": [
    "auth.totp"
  ],
  "hooks": [
    {
      "name": "auth.prepare",
      "mode": "blocking"
    },
    {
      "name": "auth.verify",
      "mode": "blocking"
    },
    {
      "name": "auth.verification",
      "mode": "blocking"
    }
  ],
  "settings": [],
  "entrypoints": {
    "handlers": "handlers.mjs"
  },
  "security": {
    "signed": true
  }
}
