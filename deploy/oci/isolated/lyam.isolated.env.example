# Isolated nominal qualification cycle - update.sh environment (FICTIVE VALUES ONLY).
# run-isolated-cycle.sh renders this template: <iso-work> -> $ISO_WORK, <checkout> ->
# the repository checkout. Every path is disposable; NONE may reference a production
# path, container, network, volume or secret. update.sh reads KEY=VALUE, no quotes.

# Front (disposable Caddy, host 127.0.0.1:8080) and backend (api-iso on LYAM_PORT 8081)
# are deliberately on DISTINCT ports.
IAM_PUBLIC_ORIGIN=http://127.0.0.1:8080
IAM_PG_URL=postgres://lyam:fictive-only-not-a-real-password@pg-iso:5432/lyam
IAM_BAO_ADDR=http://bao-iso:8200
IAM_BAO_TOKEN=fictive-placeholder-replaced-by-bao-bootstrap-isolated

# --- updater settings ---
LYAM_CONTAINER=api-iso
LYAM_DATA_DIR=<iso-work>/data
LYAM_BACKUP_DIR=<iso-work>/backups
LYAM_PORT=8081
LYAM_FRONT_BARRIER_FILE=<iso-work>/gate/MAINTENANCE
LYAM_DOCKER_NETWORK=lyam-iso-net
LYAM_LOCK_FILE=<iso-work>/.update.lock
LYAM_PAUSE_FILE=<iso-work>/UPDATE_PAUSED
LYAM_POST_UPDATE_CHECK=<checkout>/deploy/oci/isolated/run-qualification-isolated.sh

# --- cold-backup companions of the ISOLATED stack (all required once pg/bao are set) ---
LYAM_BACKUP_PG_CONTAINER=pg-iso
LYAM_BACKUP_PG_DB=lyam
LYAM_BACKUP_PG_USER=lyam
LYAM_COMPOSE_FILE=<checkout>/deploy/oci/isolated/docker-compose.isolated.yml
LYAM_COMPOSE_ENV_FILE=<iso-work>/compose.env
LYAM_BACKUP_BAO_CONTAINER=bao-iso
LYAM_BACKUP_BAO_DIR=<iso-work>/bao-storage
LYAM_BACKUP_BAO_KEYS_DIR=<iso-work>/bao-keys
LYAM_BAO_CONFIG_FILE=<checkout>/deploy/oci/isolated/bao.hcl
LYAM_BAO_POLICY_FILE=<checkout>/deploy/oci/isolated/bao-policy.hcl
LYAM_BAO_UNSEAL_CMD=<checkout>/deploy/oci/isolated/bao-unseal-isolated.sh <iso-work>/bao-keys
LYAM_STACK_FILES=<checkout>/deploy/oci/isolated/docker-compose.isolated.yml <checkout>/deploy/oci/isolated/Caddyfile.isolated <checkout>/deploy/oci/isolated/bao.hcl <checkout>/deploy/oci/isolated/bao-policy.hcl <checkout>/deploy/oci/isolated/run-isolated-cycle.sh
