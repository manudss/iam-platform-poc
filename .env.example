# Local development only. Copy to .env and change. Never commit .env.
RUNTIME_PG_PASSWORD=dev-only-change-me
TEMPORAL_PG_PASSWORD=dev-only-change-me
DOLT_ROOT_PASSWORD=dev-only-change-me
BAO_DEV_ROOT_TOKEN=dev-only-change-me

# Optional overrides for the local dev containers (infra/docker-compose.dev.yml): the shared
# tokens between the core, the API and the sign-in gate. The defaults are documented local
# placeholders (they protect nothing, like the passwords above). The API admin token is the one
# the console asks for on the administration features.
# DEV_CORE_ADMIN_TOKEN=local-dev-core-token
# DEV_API_ADMIN_TOKEN=local-dev-api-token
# DEV_AUTH_GATE_TOKEN=local-dev-gate-token
